{
  "Repository": {
    "Root": "[local-project-path]",
    "Projects": [
      {
        "Name": "[repository-name]",
        "Solution": "[solution-name]",
        "ProjectFile": "[project-path]",
        "PackageId": "[package-id]"
      }
    ]
  },
  "Build": {
    "Configuration": "Release",
    "Clean": true,
    "DeleteBin": true,
    "DeleteObj": true,
    "Pack": true
  },
  "NuGet": {
    "OutputFolder": "[local-nuget-package-path]"
  }
}
